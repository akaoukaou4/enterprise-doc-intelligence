# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =========================
# Testing / Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =========================
# Ruff / Mypy / Type checking
# =========================
.mypy_cache/
.ruff_cache/
.pyre/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Model / ML caches
# =========================
.cache/
.cache/huggingface/
huggingface/
models/
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# =========================
# Local data
# =========================
data/private/
data/raw/
data/processed/
data/uploads/
data/tmp/

# Ignore local PDFs/documents
data/**/*.pdf
data/**/*.docx
data/**/*.xlsx
data/**/*.csv

# Keep evaluation and sample-document directories
!data/sample_docs/
!data/eval/

# Scratch evaluation runs (scripts/evaluate.py writes here). A run worth keeping is moved
# to data/eval/results/, which is tracked.
data/eval/runs/

# Fictional AI-generated corpus (see data/corpus/SOURCES.md): committed on purpose
!data/corpus/*.pdf

# Docling exploration output (generated, can be large)
data/sample_docs/output/

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Docker
# =========================
docker-data/

# =========================
# OS files
# =========================
*.tmp
*.temp

# Airflow runtime
airflow/.env
airflow/logs/
airflow/config/
airflow/plugins/

# Terraform: state holds secrets, never commit it. The lock file IS committed.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
