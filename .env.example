# =============================================================================
# Copy to .env. Set the two values marked REQUIRED; the rest works as is.
# =============================================================================

# --- REQUIRED -----------------------------------------------------------------
# Hugging Face token (read access). Used once, at image build time, to download
# the gated EmbeddingGemma model. Accept its license first:
# https://huggingface.co/google/embeddinggemma-300m
HF_TOKEN=CHANGE_ME

# Gemini API key (Google AI Studio). Needed to ask questions (not to ingest).
# Free tier: prompts and responses may be used by Google to improve its
# products. Send only fictional or openly licensed documents.
GEMINI_API_KEY=CHANGE_ME

# --- Local defaults (change them for any shared environment) -------------------
POSTGRES_PASSWORD=app_password # pragma: allowlist secret
MINIO_ACCESS_KEY=minioadmin # pragma: allowlist secret
MINIO_SECRET_KEY=minioadmin123 # pragma: allowlist secret

# --- Only for running the app on the host (outside Docker) ---------------------
# Docker Compose overrides these inside containers.
APP_NAME=enterprise-doc-intelligence
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://app:app_password@localhost:5433/enterprise_docs  # pragma: allowlist secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=documents
MINIO_SECURE=false
# Optional: the default in app/core/config.py is used when this is not set.
# GEMINI_MODEL=gemini-3.5-flash-lite
# true = load the embedding model in the background at API start. Turn it off
# while editing API code with --reload.
PRELOAD_EMBEDDING_MODEL=false
