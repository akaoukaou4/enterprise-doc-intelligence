# Application
APP_ENV=development
APP_NAME=enterprise-doc-intelligence

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_docs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false

# Embedding model
EMBEDDING_MODEL=google/embeddinggemma-300m

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# API
API_HOST=0.0.0.0
API_PORT=8000