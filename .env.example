# =============================================================================
# Application
# =============================================================================

APP_NAME=enterprise-doc-intelligence
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO


# =============================================================================
# PostgreSQL
# =============================================================================

DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@localhost:5433/enterprise_docs  # pragma: allowlist secret


# =============================================================================
# MinIO / S3
# =============================================================================

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=documents
MINIO_SECURE=false


# =============================================================================
# Gemini API (Google AI Studio key)
# Free tier: prompts and responses may be used by Google to improve its
# products. Send only openly licensed documents while on the free tier.
# =============================================================================

GEMINI_API_KEY=CHANGE_ME
# Optional: the default in app/core/config.py is used when this is not set.
# GEMINI_MODEL=gemini-3.5-flash-lite
